# 이 파일을 .env로 복사한 다음, <...> 값을 실제 배포 비밀값으로 바꾸세요.
# .env.example 자체에는 작동하는 비밀값이나 서비스 토큰을 넣지 않습니다.
# 배열 값은 반드시 JSON 배열 문법을 유지하세요.

# Local PostgreSQL / Docker Compose
POSTGRES_DB=prediction_monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=<generate-a-local-postgres-password>
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://monitor:<url-encoded-password>@localhost:5432/prediction_monitor
HOST_DATABASE_URL=postgresql+asyncpg://monitor:<url-encoded-password>@localhost:5432/prediction_monitor
MIGRATION_DATABASE_URL=postgresql+asyncpg://monitor:<url-encoded-password>@localhost:5432/prediction_monitor
PG_DUMP_DATABASE_URL=postgresql://monitor:<url-encoded-password>@localhost:5432/prediction_monitor
PG_RESTORE_DATABASE_URL=postgresql://monitor:<url-encoded-password>@localhost:5432/prediction_monitor
CONTAINER_DATABASE_URL=postgresql+asyncpg://monitor:<url-encoded-password>@db:5432/prediction_monitor

# API / dashboard URLs and local ports
API_BASE_URL=http://127.0.0.1:8000
CONTAINER_API_BASE_URL=http://api:8000
API_HOST_PORT=8000
WEB_HOST_PORT=3000
# Browser-facing canonical origin. Production BFF mutations require this exact scheme, host, and port.
WEB_PUBLIC_ORIGIN=http://127.0.0.1:3000
WEB_DEPLOYMENT_ID=local-docker-compose
MONITOR_SCOPE_VERSION=scope-2026-01

# FastAPI-owned administrator and server identity secrets
ADMIN_PASSWORD_ARGON2ID_HASH=<generate-an-argon2id-password-hash>
SESSION_HMAC_SECRET=<generate-at-least-32-random-bytes>
SERVICE_TOKEN_KEY_ID=primary-2026
SERVICE_TOKEN_ISSUER_PRIVATE_KEY=<provide-the-approved-ed25519-private-key>
SERVICE_TOKEN_ISSUER_PUBLIC_KEY=<provide-the-approved-ed25519-public-key>

# Server-only BFF and scheduled-job credentials
BFF_CLIENT_CREDENTIAL=<generate-at-least-32-random-bytes>
BFF_CREDENTIAL_VERSION=bff-v1
CRON_SECRET=<generate-at-least-32-random-bytes>

# Windows worker bootstrap credential
WORKER_BOOTSTRAP_SECRET=<generate-at-least-32-random-bytes>
WORKER_CREDENTIAL_VERSION=worker-v1

# GitHub Actions OIDC allowlist. Keep these as JSON arrays, not comma-separated text.
GITHUB_REPOSITORY=<owner>/<repository>
GITHUB_WORKFLOW_REFS=["<owner>/<repository>/.github/workflows/collect.yml@refs/heads/main","<owner>/<repository>/.github/workflows/verify.yml@refs/heads/main"]
GITHUB_ALLOWED_REFS=["refs/heads/main","refs/heads/main"]
GITHUB_ALLOWED_ENVIRONMENTS=["production-collector","production-verifier"]
