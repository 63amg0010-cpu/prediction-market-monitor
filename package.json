{
  "name": "prediction-market-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace tooling for the prediction-market community monitor.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "22.14.0",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "web:dev": "pnpm --filter @prediction-market/web dev",
